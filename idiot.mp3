<audio
    id="chaosAudio"
    preload="auto"
    loop>
</audio>

<script>
const audio = document.getElementById("chaosAudio");

audio.src = "./idiot.mp3";

document.getElementById("soundBtn").onclick = async () => {
    try {
        audio.currentTime = 0;
        await audio.play();

        document.getElementById("audioStatus").textContent =
            "STATUS: LOOPING 🔊";

    } catch (error) {
        console.error(error);
        document.getElementById("audioStatus").textContent =
            "STATUS: ERROR ❌ " + error.message;
    }
};
</script>
